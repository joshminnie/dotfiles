# Brew Core
# ---------------------------------------------
tap "homebrew/bundle"
tap "homebrew/services"

# Software Development Tools and Languages
# ---------------------------------------------
brew "git"
brew "libyaml"
brew "node"
brew "postgresql@15", restart_service: true
brew "python@3.12"
brew "yarn"

# Project dependencies
# ---------------------------------------------
brew "imagemagick@6", link: true
brew "memcached", restart_service: true
brew "mysql@5.7", restart_service: true
brew "opensearch", restart_service: true

# Supporting tools
# ---------------------------------------------
brew "automake"
brew "openssl@3"
brew "glib"
brew "xorgproto"
brew "openjpeg"
brew "ghostscript"
brew "gnupg"
brew "harfbuzz"
brew "libtool"
brew "webp"
brew "openssl@1.1"
brew "protobuf"
brew "openjdk"
brew "openjdk@11"
brew "pdftk-java"
brew "pkg-config"
brew "zlib"

# App Store
# ---------------------------------------------
brew "mas"
mas "Microsoft To Do", id: 1274495053
mas "Xcode", id: 497799835

