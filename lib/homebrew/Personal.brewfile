# Brew Core
# ---------------------------------------------
tap "homebrew/bundle"
tap "homebrew/services"

# Software Development Tools and Languages
# ---------------------------------------------
brew "git"
brew "libyaml"
brew "node"
brew "postgresql@15", restart_service: true
brew "python@3.12"
brew "yarn"

# Supporting tools
# ---------------------------------------------
brew "automake"
brew "gnupg"

# App Store
# ---------------------------------------------
brew "mas"
mas "Things", id: 904280696

# VS Code Extensions
# ---------------------------------------------
