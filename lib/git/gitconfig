[core]
  autocrlf = input
  editor = /usr/local/bin/code --wait

[user]
  name = Josh Minnie
  email = josh.minnie@gmail.com

[alias]
  st = status -sb
  co = checkout
  br = branch
  prune = fetch -prune
  mg = merge --no-commit
  ll = log --oneline
  up = pull --rebase --autostash

[color]
  branch = auto
  diff = auto
  status = auto

[init]
  defaultBranch = main
