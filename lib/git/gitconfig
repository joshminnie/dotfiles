[core]
  autocrlf = input
  excludesfile = ~/.gitignore
  editor = /usr/local/bin/code --wait

[user]
  name = Josh Minnie
  email = josh.minnie@gmail.com

[alias]
  br = branch
  co = checkout
  it = "!git init && git add . && git commit -m 'Initial commit'"
  ls = log --oneline
  mg = merge --no-commit
  po = push -u origin
  prune = fetch -prune
  st = status -sb
  up = pull --rebase --autostash


[color]
  branch = auto
  diff = auto
  status = auto

[init]
  defaultBranch = main
